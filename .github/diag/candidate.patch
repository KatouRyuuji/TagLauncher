+/// 主窗 WebView2 的可见性只由 HWND 的真实状态决定：显示、未最小化、未被 DWM cloak 时可见，否则不可见。
+/// 判断放在 WebView 线程回调里，与其它 `SetIsVisible` 按投递顺序执行，读到的是执行时刻的 HWND 状态。
+/// 同时给页面打 / 去 `data-window-hidden`，由 CSS 暂停全部 CSS 动画（DESIGN §19）：
+/// WebView2 `SetIsVisible(false)` 后页面的 `document.visibilityState` 仍是 visible，
+/// 合成线程驱动的无限动画（骨架 shimmer、加载转圈）没有显示器节拍可跟，渲染 Compositor 与
+/// GPU VizCompositorThread 会以约 190 Hz 空转。
+/// 显示 / 隐藏 / 最小化 / 还原由主窗子类（[`install_main_visibility_hook`]）在
+/// `WM_WINDOWPOSCHANGED` / `WM_SIZE` 上触发，收托盘、唤出与获焦失焦也各调一次（幂等）。
+pub fn sync_main_webview(window: &tauri::WebviewWindow) {
+    #[cfg(windows)]
+    {
+        let Ok(h) = window.hwnd() else {
+            return;
+        };
+        let hwnd = h.0 as isize;
+        let w = window.clone();
+        let _ = window.with_webview(move |webview| {
+            let shown = hwnd_shown(hwnd);
+            // SAFETY：回调在 WebView 所在线程，controller 在回调期间有效
+            if let Err(e) = unsafe { webview.controller().SetIsVisible(shown) } {
+                log::warn!("[desktop] 主窗 SetIsVisible({shown}) 失败：{e}");
+            }
+            let js = if shown {
+                "document.documentElement.removeAttribute('data-window-hidden');"
+            } else {
+                "document.documentElement.setAttribute('data-window-hidden','');"
+            };
+            let _ = w.eval(js);
+        });
+    }
+    #[cfg(not(windows))]
+    let _ = window;
+}
+
+/// HWND 真的在屏幕上：可见、未最小化、未被 DWM cloak（虚拟桌面切换 / 系统隐藏）。
+#[cfg(windows)]
+fn hwnd_shown(hwnd: isize) -> bool {
+    use windows_sys::Win32::Graphics::Dwm::{DwmGetWindowAttribute, DWMWA_CLOAKED};
+    use windows_sys::Win32::UI::WindowsAndMessaging::{IsIconic, IsWindowVisible};
+    // SAFETY：hwnd 来自本进程窗口；DWMWA_CLOAKED 输出为 4 字节 DWORD
+    unsafe {
+        if IsWindowVisible(hwnd as _) == 0 || IsIconic(hwnd as _) != 0 {
+            return false;
+        }
+        let mut cloaked: u32 = 0;
+        let hr = DwmGetWindowAttribute(
+            hwnd as _,
+            DWMWA_CLOAKED as u32,
+            &mut cloaked as *mut u32 as *mut _,
+            std::mem::size_of::<u32>() as u32,
+        );
+        hr != 0 || cloaked == 0
+    }
+}
+
+/// 主窗子类：HWND 显示 / 隐藏 / 最小化 / 还原时同步 WebView2 可见性。
+/// 前端 `show()`、Tauri `hide()`、任务栏最小化都不经过本文件，只有窗口消息能覆盖所有路径。
+#[cfg(windows)]
+pub fn install_main_visibility_hook(window: &tauri::WebviewWindow) {
+    use windows_sys::Win32::Foundation::{HWND, LPARAM, LRESULT, WPARAM};
+    use windows_sys::Win32::UI::Shell::{DefSubclassProc, SetWindowSubclass};
+    use windows_sys::Win32::UI::WindowsAndMessaging::{
+        SWP_HIDEWINDOW, SWP_SHOWWINDOW, WINDOWPOS, WM_SIZE, WM_WINDOWPOSCHANGED,
+    };
+    static MAIN: OnceLock<tauri::WebviewWindow> = OnceLock::new();
+    unsafe extern "system" fn proc(
+        hwnd: HWND,
+        msg: u32,
+        wparam: WPARAM,
+        lparam: LPARAM,
+        _id: usize,
+        _data: usize,
+    ) -> LRESULT {
+        let changed = match msg {
+            // SAFETY：WM_WINDOWPOSCHANGED 的 lparam 指向 WINDOWPOS
+            WM_WINDOWPOSCHANGED => unsafe {
+                (*(lparam as *const WINDOWPOS)).flags & (SWP_SHOWWINDOW | SWP_HIDEWINDOW) != 0
+            },
+            WM_SIZE => true,
+            _ => false,
+        };
+        if changed {
+            if let Some(w) = MAIN.get() {
+                sync_main_webview(w);
+            }
+        }
+        // SAFETY：子类过程必须把消息交给下一个过程
+        unsafe { DefSubclassProc(hwnd, msg, wparam, lparam) }
+    }
+    let Ok(h) = window.hwnd() else {
+        return;
+    };
+    if MAIN.set(window.clone()).is_err() {
+        return;
+    }
+    // SAFETY：hwnd 是本线程创建的主窗；proc 为 'static 函数
+    unsafe {
+        SetWindowSubclass(h.0 as _, Some(proc), 0x544c_5649, 0);
+    }
+}
