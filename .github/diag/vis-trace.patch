+/// 诊断（临时分支）：可见性事件追踪写到 TL_DIAG_VIS_LOG。
+#[allow(dead_code)]
+pub(crate) fn diag_vis(msg: &str) {
+    if let Ok(p) = std::env::var("TL_DIAG_VIS_LOG") {
+        use std::io::Write;
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(p) {
+            let ms = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_millis()).unwrap_or(0);
+            let _ = writeln!(f, "{ms} {msg}");
+        }
+    }
+}
+#[cfg(windows)]
+pub(crate) fn diag_hwnd(hwnd: isize) -> String {
+    use windows_sys::Win32::UI::WindowsAndMessaging::{IsIconic, IsWindowVisible, GetWindowRect};
+    use windows_sys::Win32::Graphics::Dwm::{DwmGetWindowAttribute, DWMWA_CLOAKED};
+    unsafe {
+        let mut cloaked: u32 = 0;
+        let _ = DwmGetWindowAttribute(hwnd as _, DWMWA_CLOAKED as u32, &mut cloaked as *mut u32 as _, 4);
+        let mut r = std::mem::zeroed();
+        GetWindowRect(hwnd as _, &mut r);
+        format!("hwnd={hwnd:x} vis={} icon={} cloak={cloaked} rect=({},{},{},{})", IsWindowVisible(hwnd as _), IsIconic(hwnd as _), r.left, r.top, r.right, r.bottom)
+    }
+}
